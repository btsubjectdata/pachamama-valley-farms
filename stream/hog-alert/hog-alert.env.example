# /opt/pvf-stream/hog-alert.env  (mode 600, owner pvf). Never commit this file.

# --- secrets ---
PUSHOVER_TOKEN=""        # Pushover: create an application at pushover.net/apps/build, paste its API token
PUSHOVER_USER=""         # Pushover: your User Key, shown at the top of pushover.net after signing in
ANTHROPIC_API_KEY=""     # console.anthropic.com -> API keys

# --- behaviour (defaults shown; delete a line to use the default) ---
DRY_RUN="1"              # 1 = detect and log but never send a push. Set to 0 once the keys are in.
SOURCE_URL="http://127.0.0.1:8088/hog_720.m3u8"
FPS="2"
DET_IMGSZ="960"
DET_MIN_CONF="0.25"
DET_MIN_AREA="0.004"
CLASSIFY_EVERY="4"
CLAUDE_MODEL="claude-haiku-5-5"
HOG_MIN_CONF="0.7"
CONFIRMATIONS="2"
CONFIRM_WINDOW="45"
COOLDOWN="900"
PUSHOVER_PRIORITY="2"    # 2 = emergency (repeats until acknowledged, through Do Not Disturb); 1 = high; 0 = normal
PUSHOVER_RETRY="60"
PUSHOVER_EXPIRE="1800"
PUSHOVER_SOUND="siren"
ALERT_URL="https://pachamamavalleyfarm.com/#hogcam"
KEEP_HITS_DAYS="30"
